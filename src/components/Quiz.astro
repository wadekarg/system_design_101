---
// Interactive multiple-choice quiz rendered at the end of a topic.
// Fed by the `quiz` frontmatter array: { question, options[], answer, explanation }.
interface QuizItem {
  question: string;
  options: string[];
  answer: number; // index of correct option
  explanation: string;
}
interface Props {
  items: QuizItem[];
}
const { items } = Astro.props;
if (!items || items.length === 0) return null;
---
<section class="quiz" data-quiz aria-label="Knowledge check">
  <div class="quiz-header">
    <h2>Test Yourself</h2>
    <span class="quiz-score" data-quiz-score>0 / {items.length}</span>
  </div>

  {items.map((item, qi) => (
    <div class="quiz-q" data-question data-answer={item.answer}>
      <p class="quiz-prompt"><span class="quiz-num">{qi + 1}</span>{item.question}</p>
      <div class="quiz-options">
        {item.options.map((opt, oi) => (
          <button type="button" class="quiz-option" data-option={oi}>
            <span class="quiz-key">{String.fromCharCode(65 + oi)}</span>
            <span>{opt}</span>
          </button>
        ))}
      </div>
      <div class="quiz-explain" data-explain hidden>
        <strong>Why:</strong> {item.explanation}
      </div>
    </div>
  ))}
</section>

<style>
  .quiz {
    margin-top: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: #fff;
    padding: 1.5rem;
  }
  .quiz-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .quiz-header h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }
  .quiz-score {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .quiz-q { margin-bottom: 1.5rem; }
  .quiz-q:last-child { margin-bottom: 0; }
  .quiz-prompt {
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.75rem;
    display: flex;
    gap: 0.5rem;
    line-height: 1.4;
  }
  .quiz-num {
    flex: none;
    width: 1.4rem; height: 1.4rem;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent); color: #fff;
    border-radius: 999px; font-size: 0.8rem; font-weight: 700;
  }
  .quiz-options { display: flex; flex-direction: column; gap: 0.5rem; }
  .quiz-option {
    display: flex; align-items: center; gap: 0.6rem;
    text-align: left; width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: #fff;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .quiz-option:hover:not(:disabled) { background: #F9FAFB; border-color: #C7D2FE; }
  .quiz-option:disabled { cursor: default; }
  .quiz-key {
    flex: none;
    width: 1.5rem; height: 1.5rem;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--color-border); border-radius: 0.4rem;
    font-size: 0.8rem; font-weight: 700; color: var(--color-text-secondary);
  }
  .quiz-option.correct { background: #F0FDF4; border-color: #16A34A; color: #15803D; }
  .quiz-option.correct .quiz-key { background: #16A34A; color: #fff; border-color: #16A34A; }
  .quiz-option.wrong { background: #FEF2F2; border-color: #DC2626; color: #B91C1C; }
  .quiz-option.wrong .quiz-key { background: #DC2626; color: #fff; border-color: #DC2626; }
  .quiz-explain {
    margin-top: 0.75rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-accent-light);
    border-radius: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-text-primary);
    line-height: 1.5;
  }
</style>

<script>
  function initQuiz(quiz: HTMLElement) {
    const scoreEl = quiz.querySelector('[data-quiz-score]') as HTMLElement | null;
    const questions = Array.from(quiz.querySelectorAll('[data-question]')) as HTMLElement[];
    const total = questions.length;
    let score = 0;

    questions.forEach((q) => {
      const answer = Number(q.dataset.answer);
      const options = Array.from(q.querySelectorAll('.quiz-option')) as HTMLButtonElement[];
      const explain = q.querySelector('[data-explain]') as HTMLElement | null;
      let answered = false;

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          if (answered) return;
          answered = true;
          const chosen = Number(opt.dataset.option);
          if (chosen === answer) {
            opt.classList.add('correct');
            score += 1;
          } else {
            opt.classList.add('wrong');
            options[answer]?.classList.add('correct');
          }
          options.forEach((o) => { o.disabled = true; });
          if (explain) explain.hidden = false;
          if (scoreEl) scoreEl.textContent = `${score} / ${total}`;
        });
      });
    });
  }

  document.querySelectorAll('[data-quiz]').forEach((el) => initQuiz(el as HTMLElement));
</script>
