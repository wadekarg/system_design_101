---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="tu-arr" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#94A3B8"/>
    </marker>
    <marker id="tu-arr-grn" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#16A34A"/>
    </marker>
    <marker id="tu-arr-acc" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#4F46E5"/>
    </marker>
  </defs>
  <style>
    /* Request dot: Client→LB→App→Cache (HIT) returns, or App→Cache MISS→DB */
    /* 7s cycle: 0-3.5s = CACHE HIT path, 3.5-7s = CACHE MISS path */

    /* HIT path dot */
    @keyframes tu-hit {
      0%   { opacity:0; }
      3%   { opacity:1; }
      40%  { opacity:1; }
      45%  { opacity:0; }
      100% { opacity:0; }
    }
    /* MISS path dot */
    @keyframes tu-miss {
      0%,50%  { opacity:0; }
      53%     { opacity:1; }
      90%     { opacity:1; }
      95%     { opacity:0; }
      100%    { opacity:0; }
    }

    @keyframes tu-cache-hit-glow {
      0%,45%  { stroke:#16A34A; stroke-width:1.5; }
      10%     { stroke:#16A34A; stroke-width:3; }
      45%,100%{ stroke:#E2E8F0; stroke-width:1.5; }
    }
    @keyframes tu-cache-miss-glow {
      0%,50%  { stroke:#E2E8F0; stroke-width:1.5; }
      60%     { stroke:#D97706; stroke-width:3; }
      95%,100%{ stroke:#E2E8F0; stroke-width:1.5; }
    }
    @keyframes tu-db-glow {
      0%,70%  { stroke:#E2E8F0; stroke-width:1.5; }
      80%     { stroke:#0284C7; stroke-width:3; }
      95%,100%{ stroke:#E2E8F0; stroke-width:1.5; }
    }

    .tu-hit-dot  { animation: tu-hit  7s linear infinite; }
    .tu-miss-dot { animation: tu-miss 7s linear infinite; }
    .tu-cache    { animation: tu-cache-hit-glow 7s linear infinite; }
    .tu-cache-m  { animation: tu-cache-miss-glow 7s linear infinite; }
    .tu-db-rect  { animation: tu-db-glow 7s linear infinite; }

    @media (prefers-reduced-motion: reduce) {
      * { animation-play-state: paused !important; }
    }
  </style>

  <rect width="600" height="280" fill="#F8FAFC" rx="12"/>
  <text x="300" y="22" text-anchor="middle" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#1E293B">TinyURL — System Design</text>

  <!-- ── TOP: URL shortening concept ── -->
  <rect x="10" y="32" width="580" height="36" rx="7" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
  <text x="18" y="47" font-family="monospace,sans-serif" font-size="9.5" fill="#475569">https://very-long-url.com/articles/2024/system-design/deep-dive</text>
  <text x="360" y="47" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#4F46E5">→</text>
  <rect x="378" y="35" width="120" height="26" rx="5" fill="#4F46E5"/>
  <text x="438" y="52" text-anchor="middle" font-family="monospace,sans-serif" font-size="10" font-weight="700" fill="white">turl.io/abc123</text>
  <text x="510" y="47" font-family="system-ui,sans-serif" font-size="8.5" fill="#64748B">Base62</text>

  <!-- ── BOTTOM: Architecture flow ── -->
  <!-- Row of boxes: Client → LB → App Server → Cache → DB -->
  <!-- Client -->
  <rect x="12"  y="112" width="80" height="48" rx="7" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="52"  y="132" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#1E293B">Client</text>
  <text x="52"  y="148" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#64748B">Browser</text>

  <!-- Arrow: Client→LB -->
  <line x1="92" y1="136" x2="116" y2="136" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#tu-arr)"/>

  <!-- Load Balancer -->
  <rect x="118" y="112" width="80" height="48" rx="7" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="158" y="132" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#1E293B">Load</text>
  <text x="158" y="148" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#1E293B">Balancer</text>

  <!-- Arrow: LB→App -->
  <line x1="198" y1="136" x2="222" y2="136" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#tu-arr)"/>

  <!-- App Server -->
  <rect x="224" y="108" width="90" height="56" rx="7" fill="#EEF2FF" stroke="#4F46E5" stroke-width="1.5"/>
  <text x="269" y="132" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#4F46E5">App Server</text>
  <text x="269" y="148" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8" fill="#6366F1">Base62 encode</text>

  <!-- Arrow: App→Cache -->
  <line x1="314" y1="136" x2="336" y2="136" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#tu-arr)"/>

  <!-- Cache (Redis) -->
  <rect x="338" y="108" width="86" height="56" rx="7" fill="#F0FDF4" stroke="#16A34A" stroke-width="1.5" class="tu-cache"/>
  <text x="381" y="130" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#16A34A">Cache</text>
  <text x="381" y="144" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#16A34A">Redis</text>

  <!-- Cache HIT label (top) -->
  <text x="381" y="100" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" font-weight="700" fill="#16A34A">HIT ↩ fast path</text>

  <!-- Arrow: Cache→DB (MISS path) -->
  <line x1="424" y1="136" x2="448" y2="136" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#tu-arr)"/>

  <!-- DB (PostgreSQL) -->
  <rect x="450" y="108" width="90" height="56" rx="7" fill="#EFF6FF" stroke="#0284C7" stroke-width="1.5" class="tu-db-rect"/>
  <!-- cylinder top -->
  <ellipse cx="495" cy="120" rx="32" ry="7" fill="#BFDBFE"/>
  <text x="495" y="140" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#0284C7">Database</text>
  <text x="495" y="154" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#0284C7">PostgreSQL</text>

  <!-- CACHE MISS label -->
  <text x="436" y="170" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#D97706">MISS →</text>

  <!-- Animated request dot: HIT path (stops at cache) -->
  <circle r="5" fill="#16A34A" class="tu-hit-dot">
    <animate attributeName="cx" values="52;52;158;269;381;381;269;158;52" keyTimes="0;0.03;0.12;0.22;0.32;0.38;0.40;0.42;0.45" dur="7s" repeatCount="indefinite"/>
    <animate attributeName="cy" values="136;136;136;136;136;136;136;136;136" keyTimes="0;0.03;0.12;0.22;0.32;0.38;0.40;0.42;0.45" dur="7s" repeatCount="indefinite"/>
  </circle>

  <!-- Animated request dot: MISS path (goes all the way to DB) -->
  <circle r="5" fill="#D97706" class="tu-miss-dot">
    <animate attributeName="cx" values="52;52;158;269;381;495;495;269;52" keyTimes="0;0.50;0.58;0.66;0.74;0.82;0.86;0.90;0.95" dur="7s" repeatCount="indefinite"/>
    <animate attributeName="cy" values="136;136;136;136;136;136;136;136;136" keyTimes="0;0.50;0.58;0.66;0.74;0.82;0.86;0.90;0.95" dur="7s" repeatCount="indefinite"/>
  </circle>

  <!-- Legend -->
  <rect x="10" y="186" width="580" height="82" rx="7" fill="#F1F5F9" stroke="#E2E8F0" stroke-width="1"/>
  <text x="300" y="204" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#64748B">KEY DESIGN DECISIONS</text>
  <!-- HIT legend -->
  <circle cx="28" cy="220" r="5" fill="#16A34A"/>
  <text x="40" y="224" font-family="system-ui,sans-serif" font-size="9.5" fill="#475569">Cache HIT: read from Redis in ~1ms, no DB query</text>
  <!-- MISS legend -->
  <circle cx="28" cy="240" r="5" fill="#D97706"/>
  <text x="40" y="244" font-family="system-ui,sans-serif" font-size="9.5" fill="#475569">Cache MISS: query PostgreSQL, populate cache (write-through)</text>
  <text x="28" y="260" font-family="system-ui,sans-serif" font-size="9.5" fill="#475569">Base62 encode(ID): 7 chars → 62⁷ = 3.5 trillion unique URLs</text>
</svg>
</div>
