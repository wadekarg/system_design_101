---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
<style>
  .nosql-label { font-family: system-ui, sans-serif; font-size: 10px; fill: #64748B; }
  .nosql-title { font-family: system-ui, sans-serif; font-size: 12px; font-weight: 700; fill: #1E293B; }
  .nosql-db { font-family: system-ui, sans-serif; font-size: 10px; font-weight: 600; fill: #4F46E5; }
  .nosql-code { font-family: monospace; font-size: 10px; fill: #1E293B; }
  .node-pulse { animation: nodePulse 2s ease-in-out infinite; }
  .kv-dash { stroke-dasharray: 6,3; animation: kvDash 1.5s linear infinite; }
  .graph-edge { animation: graphEdge 2.5s ease-in-out infinite; }
  @keyframes nodePulse {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 1; }
  }
  @keyframes kvDash {
    from { stroke-dashoffset: 18; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes graphEdge {
    0%, 100% { stroke-width: 1.5; opacity: 0.5; }
    50% { stroke-width: 2.5; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { * { animation-play-state: paused !important; } }
</style>

<!-- Outer border -->
<rect x="2" y="2" width="596" height="276" rx="8" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>

<!-- Grid dividers -->
<line x1="300" y1="2" x2="300" y2="278" stroke="#E2E8F0" stroke-width="2"/>
<line x1="2" y1="141" x2="598" y2="141" stroke="#E2E8F0" stroke-width="2"/>

<!-- ===== TOP-LEFT: Key-Value ===== -->
<text x="20" y="22" class="nosql-title">Key-Value</text>
<text x="20" y="36" class="nosql-db">Redis</text>
<!-- Key box -->
<rect x="18" y="46" width="84" height="28" rx="5" fill="#EEF2FF" stroke="#4F46E5" stroke-width="1.5"/>
<text x="60" y="64" text-anchor="middle" font-family="monospace" font-size="10" fill="#3730A3">"user:42"</text>
<!-- Animated arrow -->
<line x1="106" y1="60" x2="168" y2="60" stroke="#4F46E5" stroke-width="2" class="kv-dash"/>
<polygon points="168,55 180,60 168,65" fill="#4F46E5"/>
<text x="137" y="54" text-anchor="middle" class="nosql-label">O(1)</text>
<!-- Value box -->
<rect x="182" y="44" width="102" height="44" rx="5" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
<text x="233" y="62" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">&#123; name: "Alice",</text>
<text x="233" y="74" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">  age: 28 &#125;</text>
<!-- Labels -->
<text x="60" y="104" text-anchor="middle" class="nosql-label">Key (string/hash)</text>
<text x="233" y="104" text-anchor="middle" class="nosql-label">Value (any blob)</text>
<!-- Use-case strip -->
<rect x="12" y="115" width="276" height="20" rx="4" fill="#EEF2FF"/>
<text x="150" y="129" text-anchor="middle" class="nosql-label" fill="#4338CA">Sessions · Cache · Leaderboards · O(1) lookup</text>

<!-- ===== TOP-RIGHT: Document ===== -->
<text x="314" y="22" class="nosql-title">Document</text>
<text x="314" y="36" class="nosql-db">MongoDB</text>
<rect x="314" y="44" width="138" height="78" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
<text x="324" y="59" font-family="monospace" font-size="9" fill="#64748B">&#123;</text>
<text x="332" y="71" font-family="monospace" font-size="9" fill="#1E293B">"id": 1,</text>
<text x="332" y="83" font-family="monospace" font-size="9" fill="#1E293B">"name": "Alice",</text>
<text x="332" y="95" font-family="monospace" font-size="9" fill="#1E293B">"tags": ["dev"],</text>
<text x="332" y="107" font-family="monospace" font-size="9" fill="#4F46E5">"addr": &#123; ... &#125;</text>
<text x="324" y="118" font-family="monospace" font-size="9" fill="#64748B">&#125;</text>
<!-- Nested badge -->
<rect x="460" y="48" width="122" height="30" rx="5" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="521" y="63" text-anchor="middle" font-family="system-ui" font-size="10" fill="#4338CA" font-weight="600">Nested sub-docs</text>
<text x="521" y="75" text-anchor="middle" class="nosql-label">flexible schema</text>
<!-- Use-case strip -->
<rect x="304" y="115" width="288" height="20" rx="4" fill="#EEF2FF"/>
<text x="448" y="129" text-anchor="middle" class="nosql-label" fill="#4338CA">User profiles · CMS · Product catalogs</text>

<!-- ===== BOTTOM-LEFT: Column-Family ===== -->
<text x="20" y="158" class="nosql-title">Column-Family</text>
<text x="20" y="172" class="nosql-db">Cassandra</text>
<!-- Header row -->
<rect x="12" y="178" width="62" height="22" rx="3" fill="#1E293B"/>
<text x="43" y="193" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="700">Row Key</text>
<rect x="78" y="178" width="52" height="22" rx="3" fill="#4F46E5" class="node-pulse"/>
<text x="104" y="193" text-anchor="middle" font-family="system-ui" font-size="9" fill="white">col_a</text>
<rect x="134" y="178" width="52" height="22" rx="3" fill="#4F46E5" class="node-pulse" style="animation-delay:0.4s"/>
<text x="160" y="193" text-anchor="middle" font-family="system-ui" font-size="9" fill="white">col_b</text>
<rect x="190" y="178" width="52" height="22" rx="3" fill="#4F46E5" class="node-pulse" style="animation-delay:0.8s"/>
<text x="216" y="193" text-anchor="middle" font-family="system-ui" font-size="9" fill="white">col_c</text>
<rect x="246" y="178" width="40" height="22" rx="3" fill="#4F46E5" class="node-pulse" style="animation-delay:1.2s"/>
<text x="266" y="193" text-anchor="middle" font-family="system-ui" font-size="9" fill="white">col_d</text>
<!-- Data row 1 -->
<rect x="12" y="204" width="62" height="20" rx="3" fill="#334155"/>
<text x="43" y="218" text-anchor="middle" font-family="monospace" font-size="9" fill="#CBD5E1">user:1</text>
<rect x="78" y="204" width="52" height="20" rx="3" fill="#F8FAFC" stroke="#E2E8F0"/>
<text x="104" y="218" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">Alice</text>
<rect x="134" y="204" width="52" height="20" rx="3" fill="#F8FAFC" stroke="#E2E8F0"/>
<text x="160" y="218" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">28</text>
<rect x="190" y="204" width="52" height="20" rx="3" fill="#F8FAFC" stroke="#E2E8F0"/>
<text x="216" y="218" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">NYC</text>
<rect x="246" y="204" width="40" height="20" rx="3" fill="#F8FAFC" stroke="#E2E8F0"/>
<text x="266" y="218" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">eng</text>
<!-- Data row 2 (sparse) -->
<rect x="12" y="228" width="62" height="20" rx="3" fill="#334155"/>
<text x="43" y="242" text-anchor="middle" font-family="monospace" font-size="9" fill="#CBD5E1">user:2</text>
<rect x="78" y="228" width="52" height="20" rx="3" fill="#F8FAFC" stroke="#E2E8F0"/>
<text x="104" y="242" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">Bob</text>
<rect x="134" y="228" width="52" height="20" rx="3" fill="#F1F5F9" stroke="#E2E8F0" stroke-dasharray="3,2"/>
<text x="160" y="242" text-anchor="middle" class="nosql-label">—</text>
<rect x="190" y="228" width="52" height="20" rx="3" fill="#F8FAFC" stroke="#E2E8F0"/>
<text x="216" y="242" text-anchor="middle" font-family="monospace" font-size="9" fill="#1E293B">LA</text>
<rect x="246" y="228" width="40" height="20" rx="3" fill="#F1F5F9" stroke="#E2E8F0" stroke-dasharray="3,2"/>
<text x="266" y="242" text-anchor="middle" class="nosql-label">—</text>
<text x="150" y="264" text-anchor="middle" class="nosql-label">Sparse cols OK · Wide rows · Time-series · IoT</text>

<!-- ===== BOTTOM-RIGHT: Graph ===== -->
<text x="314" y="158" class="nosql-title">Graph</text>
<text x="314" y="172" class="nosql-db">Neo4j</text>
<!-- Edges -->
<line x1="420" y1="215" x2="492" y2="192" stroke="#4F46E5" stroke-width="2" class="graph-edge"/>
<line x1="420" y1="215" x2="470" y2="255" stroke="#4F46E5" stroke-width="2" class="graph-edge" style="animation-delay:0.6s"/>
<line x1="492" y1="192" x2="470" y2="255" stroke="#94A3B8" stroke-width="1.5" class="graph-edge" style="animation-delay:1.2s"/>
<line x1="365" y1="225" x2="420" y2="215" stroke="#D97706" stroke-width="2" class="graph-edge" style="animation-delay:0.3s"/>
<!-- Edge labels -->
<text x="458" y="198" text-anchor="middle" font-family="system-ui" font-size="8" fill="#4F46E5">KNOWS</text>
<text x="440" y="243" text-anchor="middle" font-family="system-ui" font-size="8" fill="#4F46E5">LIKES</text>
<text x="390" y="214" text-anchor="middle" font-family="system-ui" font-size="8" fill="#D97706">FOLLOWS</text>
<!-- Nodes -->
<circle cx="420" cy="215" r="18" fill="#4F46E5" class="node-pulse"/>
<text x="420" y="212" text-anchor="middle" font-family="system-ui" font-size="8" fill="white" font-weight="700">Alice</text>
<text x="420" y="223" text-anchor="middle" font-family="system-ui" font-size="7" fill="#C7D2FE">Person</text>
<circle cx="492" cy="192" r="17" fill="#4F46E5" class="node-pulse" style="animation-delay:0.5s"/>
<text x="492" y="189" text-anchor="middle" font-family="system-ui" font-size="8" fill="white" font-weight="700">Bob</text>
<text x="492" y="200" text-anchor="middle" font-family="system-ui" font-size="7" fill="#C7D2FE">Person</text>
<circle cx="470" cy="255" r="15" fill="#16A34A" class="node-pulse" style="animation-delay:1s"/>
<text x="470" y="253" text-anchor="middle" font-family="system-ui" font-size="8" fill="white" font-weight="700">Post</text>
<text x="470" y="263" text-anchor="middle" font-family="system-ui" font-size="7" fill="#BBF7D0">Article</text>
<circle cx="365" cy="225" r="14" fill="#D97706" class="node-pulse" style="animation-delay:1.5s"/>
<text x="365" y="229" text-anchor="middle" font-family="system-ui" font-size="8" fill="white" font-weight="700">Carol</text>
<text x="450" y="275" text-anchor="middle" class="nosql-label">Social graphs · Fraud · Recommendations</text>
</svg>
</div>
