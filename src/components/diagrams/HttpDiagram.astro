---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <style>
    @keyframes fadeIn1 { 0%,5%{opacity:0} 12%,85%{opacity:1} 92%,100%{opacity:0} }
    @keyframes fadeIn2 { 0%,18%{opacity:0} 25%,85%{opacity:1} 92%,100%{opacity:0} }
    @keyframes fadeIn3 { 0%,32%{opacity:0} 39%,85%{opacity:1} 92%,100%{opacity:0} }
    @keyframes fadeIn4 { 0%,48%{opacity:0} 55%,85%{opacity:1} 92%,100%{opacity:0} }
    @keyframes fadeIn5 { 0%,62%{opacity:0} 69%,92%{opacity:1} 96%,100%{opacity:0} }
    .a1 { animation: fadeIn1 6s ease-in-out infinite; opacity:0; }
    .a2 { animation: fadeIn2 6s ease-in-out infinite; opacity:0; }
    .a3 { animation: fadeIn3 6s ease-in-out infinite; opacity:0; }
    .a4 { animation: fadeIn4 6s ease-in-out infinite; opacity:0; }
    .a5 { animation: fadeIn5 6s ease-in-out infinite; opacity:0; }
    @media (prefers-reduced-motion: reduce) {
      * { animation-play-state: paused !important; }
    }
  </style>
  <defs>
    <marker id="arrowB" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#4F46E5"/>
    </marker>
    <marker id="arrowL" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#4F46E5"/>
    </marker>
    <marker id="arrowG" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#16A34A"/>
    </marker>
    <marker id="arrowGL" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#16A34A"/>
    </marker>
  </defs>

  <!-- Client box -->
  <rect x="30" y="100" width="110" height="80" rx="8" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="85" y="136" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#1E293B" text-anchor="middle">Client</text>
  <text x="85" y="154" font-family="system-ui,sans-serif" font-size="10" fill="#64748B" text-anchor="middle">Browser / App</text>

  <!-- Server box -->
  <rect x="460" y="100" width="110" height="80" rx="8" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="515" y="136" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#1E293B" text-anchor="middle">Server</text>
  <text x="515" y="154" font-family="system-ui,sans-serif" font-size="10" fill="#64748B" text-anchor="middle">Web / API</text>

  <!-- Handshake region label -->
  <rect x="150" y="12" width="300" height="18" rx="4" fill="#EDE9FE"/>
  <text x="300" y="25" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#6D28D9" text-anchor="middle">TCP 3-Way Handshake</text>

  <!-- HTTP region label -->
  <rect x="150" y="188" width="300" height="18" rx="4" fill="#F0FDF4"/>
  <text x="300" y="201" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#15803D" text-anchor="middle">HTTP Exchange</text>

  <!-- Arrow 1: SYN → (dashed) -->
  <g class="a1">
    <line x1="143" y1="122" x2="458" y2="122" stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3" marker-end="url(#arrowB)"/>
    <rect x="240" y="106" width="120" height="16" rx="3" fill="white" opacity="0.9"/>
    <text x="300" y="118" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#4F46E5" text-anchor="middle">SYN  →</text>
  </g>

  <!-- Arrow 2: ← SYN-ACK (dashed) -->
  <g class="a2">
    <line x1="458" y1="140" x2="143" y2="140" stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3" marker-end="url(#arrowL)"/>
    <rect x="230" y="124" width="140" height="16" rx="3" fill="white" opacity="0.9"/>
    <text x="300" y="136" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#4F46E5" text-anchor="middle">← SYN-ACK</text>
  </g>

  <!-- Arrow 3: ACK → (dashed) -->
  <g class="a3">
    <line x1="143" y1="158" x2="458" y2="158" stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3" marker-end="url(#arrowB)"/>
    <rect x="240" y="142" width="120" height="16" rx="3" fill="white" opacity="0.9"/>
    <text x="300" y="154" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#4F46E5" text-anchor="middle">ACK  →</text>
  </g>

  <!-- Arrow 4: HTTP GET → (solid) -->
  <g class="a4">
    <line x1="143" y1="218" x2="458" y2="218" stroke="#16A34A" stroke-width="2.5" marker-end="url(#arrowG)"/>
    <rect x="220" y="202" width="160" height="16" rx="3" fill="white" opacity="0.9"/>
    <text x="300" y="214" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#16A34A" text-anchor="middle">HTTP GET /index.html  →</text>
  </g>

  <!-- Arrow 5: ← 200 OK (solid) -->
  <g class="a5">
    <line x1="458" y1="238" x2="143" y2="238" stroke="#16A34A" stroke-width="2.5" marker-end="url(#arrowGL)"/>
    <rect x="230" y="222" width="140" height="16" rx="3" fill="white" opacity="0.9"/>
    <text x="300" y="234" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#16A34A" text-anchor="middle">← 200 OK + Body</text>
  </g>

  <!-- Bottom hint -->
  <text x="300" y="272" font-family="system-ui,sans-serif" font-size="9" fill="#94A3B8" text-anchor="middle">Dashed = TCP handshake  ·  Solid = HTTP data</text>
</svg>
</div>
