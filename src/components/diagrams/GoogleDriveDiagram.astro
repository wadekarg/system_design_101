---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="gd-arr" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#94A3B8"/>
    </marker>
    <marker id="gd-arr-acc" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#4F46E5"/>
    </marker>
    <marker id="gd-arr-blu" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#0284C7"/>
    </marker>
  </defs>
  <style>
    /* 8s cycle: Block1→storage, Block2→storage, Block3→storage, Block4→storage */
    @keyframes gd-b1 {
      0%   { opacity:0; }
      4%   { opacity:1; }
      20%  { opacity:1; transform:translate(248px, 0); }
      24%  { opacity:0; }
      100% { opacity:0; transform:translate(248px, 0); }
    }
    @keyframes gd-b2 {
      0%,24% { opacity:0; }
      28%    { opacity:1; }
      44%    { opacity:1; transform:translate(248px, 0); }
      48%    { opacity:0; }
      100%   { opacity:0; }
    }
    @keyframes gd-b3 {
      0%,48% { opacity:0; }
      52%    { opacity:1; }
      68%    { opacity:1; transform:translate(248px, 0); }
      72%    { opacity:0; }
      100%   { opacity:0; }
    }
    @keyframes gd-b4 {
      0%,72% { opacity:0; }
      76%    { opacity:1; }
      92%    { opacity:1; transform:translate(248px, 0); }
      96%    { opacity:0; }
      100%   { opacity:0; }
    }

    @keyframes gd-meta-pulse {
      0%,100% { opacity:1; }
      12%     { opacity:0.7; transform:scale(1.04); }
      24%     { opacity:1; transform:scale(1); }
    }
    @keyframes gd-storage-light {
      0%,100% { stroke:#0284C7; stroke-width:1.5; }
      22%     { stroke:#0284C7; stroke-width:3; }
      24%     { stroke:#0284C7; stroke-width:1.5; }
      46%     { stroke:#0284C7; stroke-width:3; }
      48%     { stroke:#0284C7; stroke-width:1.5; }
      70%     { stroke:#0284C7; stroke-width:3; }
      72%     { stroke:#0284C7; stroke-width:1.5; }
      94%     { stroke:#0284C7; stroke-width:3; }
      96%     { stroke:#0284C7; stroke-width:1.5; }
    }

    .gd-b1 { animation: gd-b1 8s linear infinite; }
    .gd-b2 { animation: gd-b2 8s linear infinite; }
    .gd-b3 { animation: gd-b3 8s linear infinite; }
    .gd-b4 { animation: gd-b4 8s linear infinite; }
    .gd-meta    { animation: gd-meta-pulse 8s ease-in-out infinite; transform-origin: 216px 90px; }
    .gd-storage { animation: gd-storage-light 8s linear infinite; }

    @media (prefers-reduced-motion: reduce) {
      * { animation-play-state: paused !important; }
    }
  </style>

  <rect width="600" height="280" fill="#F8FAFC" rx="12"/>
  <text x="300" y="22" text-anchor="middle" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#1E293B">Google Drive — File Storage</text>

  <!-- ── Client ── -->
  <rect x="10" y="60" width="80" height="160" rx="7" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="50" y="82" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#1E293B">Client</text>
  <!-- File icon -->
  <rect x="28" y="92" width="44" height="56" rx="3" fill="#EEF2FF" stroke="#4F46E5" stroke-width="1.5"/>
  <line x1="28" y1="104" x2="72" y2="104" stroke="#4F46E5" stroke-width="1"/>
  <text x="50" y="118" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#4F46E5">document</text>
  <text x="50" y="130" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7" fill="#4F46E5">.pdf</text>
  <!-- Split into blocks -->
  <text x="50" y="162" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#64748B">split into</text>
  <text x="50" y="174" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#64748B">4MB blocks</text>
  <rect x="24" y="182" width="52" height="24" rx="3" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1"/>
  <text x="50" y="198" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8" fill="#475569">B1 B2 B3 B4</text>

  <!-- Arrow: Client→Metadata -->
  <line x1="90" y1="88" x2="148" y2="88" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#gd-arr)"/>
  <text x="119" y="80" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#64748B">file info</text>

  <!-- Arrow: Client→Block Storage -->
  <line x1="90" y1="180" x2="148" y2="180" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#gd-arr-blu)"/>
  <text x="119" y="172" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#0284C7">chunks</text>

  <!-- ── Metadata Service ── -->
  <g class="gd-meta">
    <rect x="150" y="58" width="132" height="60" rx="7" fill="#EEF2FF" stroke="#4F46E5" stroke-width="1.5"/>
    <text x="216" y="80" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#4F46E5">Metadata</text>
    <text x="216" y="94" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#4F46E5">Service</text>
    <!-- DB cylinder icon -->
    <ellipse cx="216" cy="108" rx="24" ry="6" fill="#C7D2FE"/>
    <rect x="192" y="108" width="48" height="10" fill="#C7D2FE"/>
    <ellipse cx="216" cy="118" rx="24" ry="6" fill="#A5B4FC"/>
    <text x="216" y="116" text-anchor="middle" font-family="system-ui,sans-serif" font-size="6.5" fill="#3730A3">SQL</text>
  </g>

  <!-- ── Block Storage ── -->
  <rect x="150" y="154" width="132" height="58" rx="7" fill="#EFF6FF" stroke="#0284C7" stroke-width="1.5" class="gd-storage"/>
  <text x="216" y="178" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#0284C7">Block Storage</text>
  <text x="216" y="194" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" fill="#0284C7">S3 / GCS</text>
  <text x="216" y="206" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#0369A1">content-addressed</text>

  <!-- ── Block storage rows ── -->
  <!-- Arrow to blocks -->
  <line x1="282" y1="183" x2="318" y2="140" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#gd-arr)"/>
  <line x1="282" y1="183" x2="318" y2="170" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#gd-arr)"/>
  <line x1="282" y1="183" x2="318" y2="200" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#gd-arr)"/>
  <line x1="282" y1="183" x2="318" y2="230" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#gd-arr)"/>

  <!-- Block boxes -->
  <rect x="320" y="124" width="110" height="30" rx="5" fill="#EFF6FF" stroke="#0284C7" stroke-width="1.5"/>
  <text x="360" y="143" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9.5" font-weight="600" fill="#0284C7">Block 1</text>
  <text x="415" y="143" font-family="monospace,sans-serif" font-size="7" fill="#64748B">a3f9...</text>

  <rect x="320" y="158" width="110" height="30" rx="5" fill="#EFF6FF" stroke="#0284C7" stroke-width="1.5"/>
  <text x="360" y="177" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9.5" font-weight="600" fill="#0284C7">Block 2</text>
  <text x="415" y="177" font-family="monospace,sans-serif" font-size="7" fill="#64748B">7b2e...</text>

  <rect x="320" y="192" width="110" height="30" rx="5" fill="#EFF6FF" stroke="#0284C7" stroke-width="1.5"/>
  <text x="360" y="211" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9.5" font-weight="600" fill="#0284C7">Block 3</text>
  <text x="415" y="211" font-family="monospace,sans-serif" font-size="7" fill="#64748B">c91d...</text>

  <rect x="320" y="226" width="110" height="30" rx="5" fill="#EFF6FF" stroke="#0284C7" stroke-width="1.5"/>
  <text x="360" y="245" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9.5" font-weight="600" fill="#0284C7">Block 4</text>
  <text x="415" y="245" font-family="monospace,sans-serif" font-size="7" fill="#64748B">f45a...</text>

  <!-- Animated block upload dots (travel from client area to block boxes) -->
  <rect width="22" height="12" rx="3" fill="#0284C7" class="gd-b1">
    <animate attributeName="x" values="68;68;320" keyTimes="0;0.04;0.20" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="y" values="183;183;133" keyTimes="0;0.04;0.20" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;0.04;0.20;0.24;1" dur="8s" repeatCount="indefinite"/>
  </rect>
  <rect width="22" height="12" rx="3" fill="#4F46E5" class="gd-b2">
    <animate attributeName="x" values="68;68;320" keyTimes="0;0.28;0.44" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="y" values="183;183;167" keyTimes="0;0.28;0.44" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.24;0.28;0.44;0.48;1" dur="8s" repeatCount="indefinite"/>
  </rect>
  <rect width="22" height="12" rx="3" fill="#0284C7" class="gd-b3">
    <animate attributeName="x" values="68;68;320" keyTimes="0;0.52;0.68" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="y" values="183;183;201" keyTimes="0;0.52;0.68" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.48;0.52;0.68;0.72;1" dur="8s" repeatCount="indefinite"/>
  </rect>
  <rect width="22" height="12" rx="3" fill="#4F46E5" class="gd-b4">
    <animate attributeName="x" values="68;68;320" keyTimes="0;0.76;0.92" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="y" values="183;183;235" keyTimes="0;0.76;0.92" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.72;0.76;0.92;0.96;1" dur="8s" repeatCount="indefinite"/>
  </rect>

  <!-- Delta sync note -->
  <rect x="450" y="60" width="140" height="56" rx="6" fill="#FFFBEB" stroke="#D97706" stroke-width="1.5"/>
  <text x="520" y="79"  text-anchor="middle" font-family="system-ui,sans-serif" font-size="11" font-weight="700" fill="#D97706">Δ Delta Sync</text>
  <text x="520" y="94"  text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" fill="#92400E">Only changed blocks</text>
  <text x="520" y="107" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" fill="#92400E">are re-uploaded</text>
</svg>
</div>
