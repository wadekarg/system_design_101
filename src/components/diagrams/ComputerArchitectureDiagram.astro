---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <style>
    @keyframes travelUp {
      0%   { transform: translateY(0px);   opacity: 0; }
      6%   { transform: translateY(0px);   opacity: 1; }
      30%  { transform: translateY(-60px); opacity: 1; }
      55%  { transform: translateY(-120px); opacity: 1; }
      80%  { transform: translateY(-180px); opacity: 1; }
      92%  { transform: translateY(-180px); opacity: 0; }
      100% { transform: translateY(0px);   opacity: 0; }
    }
    .travel-dot {
      animation: travelUp 3.2s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation-play-state: paused !important; }
    }
  </style>

  <!-- CPU box -->
  <rect x="100" y="14" width="340" height="54" rx="8" fill="#4F46E5" stroke="#3730A3" stroke-width="1.5"/>
  <text x="270" y="38" font-family="system-ui,sans-serif" font-size="15" font-weight="700" fill="white" text-anchor="middle">CPU</text>
  <text x="270" y="56" font-family="system-ui,sans-serif" font-size="11" fill="#C7D2FE" text-anchor="middle">Processing Unit</text>

  <!-- Cache box -->
  <rect x="100" y="84" width="340" height="54" rx="8" fill="#FEF3C7" stroke="#FCD34D" stroke-width="1.5"/>
  <text x="270" y="108" font-family="system-ui,sans-serif" font-size="15" font-weight="700" fill="#92400E" text-anchor="middle">L1 / L2 / L3 Cache</text>
  <text x="270" y="126" font-family="system-ui,sans-serif" font-size="11" fill="#B45309" text-anchor="middle">On-chip / Near-chip Memory</text>

  <!-- RAM box -->
  <rect x="100" y="154" width="340" height="54" rx="8" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1.5"/>
  <text x="270" y="178" font-family="system-ui,sans-serif" font-size="15" font-weight="700" fill="#1D4ED8" text-anchor="middle">RAM</text>
  <text x="270" y="196" font-family="system-ui,sans-serif" font-size="11" fill="#3B82F6" text-anchor="middle">Main Memory (DRAM)</text>

  <!-- SSD/HDD box -->
  <rect x="100" y="224" width="340" height="54" rx="8" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5"/>
  <text x="270" y="248" font-family="system-ui,sans-serif" font-size="15" font-weight="700" fill="#334155" text-anchor="middle">SSD / HDD</text>
  <text x="270" y="266" font-family="system-ui,sans-serif" font-size="11" fill="#64748B" text-anchor="middle">Persistent Storage</text>

  <!-- Speed labels on right -->
  <text x="452" y="45" font-family="system-ui,sans-serif" font-size="12" font-weight="600" fill="#4F46E5">~1 ns</text>
  <text x="452" y="115" font-family="system-ui,sans-serif" font-size="12" font-weight="600" fill="#D97706">~10 ns</text>
  <text x="452" y="185" font-family="system-ui,sans-serif" font-size="12" font-weight="600" fill="#2563EB">~100 ns</text>
  <text x="452" y="255" font-family="system-ui,sans-serif" font-size="12" font-weight="600" fill="#64748B">~10 ms</text>

  <!-- Vertical guide line for dot -->
  <line x1="74" y1="41" x2="74" y2="251" stroke="#E2E8F0" stroke-width="2" stroke-dasharray="4,3"/>
  <!-- Arrow tip at top -->
  <polygon points="74,16 69,28 79,28" fill="#94A3B8"/>

  <!-- Animated dot: starts at SSD level, moves up to CPU -->
  <g class="travel-dot">
    <circle cx="74" cy="251" r="6" fill="#4F46E5"/>
    <circle cx="74" cy="251" r="3" fill="white"/>
  </g>
</svg>
</div>
