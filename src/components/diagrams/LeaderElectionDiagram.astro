---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
<style>
  .le-label { font-family: system-ui, sans-serif; font-size: 10px; fill: #64748B; }
  /* Pentagon node animations */
  .node-base { animation: nodeAnim 8s ease-in-out infinite; }
  .node-base2 { animation: nodeAnim 8s ease-in-out infinite; animation-delay: 0.15s; }
  .node-base3 { animation: nodeAnim 8s ease-in-out infinite; animation-delay: 0.3s; }
  .node-base4 { animation: nodeAnim 8s ease-in-out infinite; animation-delay: 0.45s; }
  .node-base5 { animation: nodeAnim 8s ease-in-out infinite; animation-delay: 0.6s; }
  /* Leader glow */
  .leader-glow { animation: leaderGlow 8s ease-in-out infinite; }
  /* Heartbeat lines from leader to followers */
  .hb-line { stroke-dasharray: 6,4; animation: hbDash 8s ease-in-out infinite; }
  .hb-dot1 { animation: hbDot1 8s ease-in-out infinite; }
  .hb-dot2 { animation: hbDot2 8s ease-in-out infinite; }
  .hb-dot3 { animation: hbDot3 8s ease-in-out infinite; }
  .hb-dot4 { animation: hbDot4 8s ease-in-out infinite; }
  /* Election flash */
  .election-flash { animation: electionFlash 8s ease-in-out infinite; }
  /* Phase label */
  .phase-label { animation: phaseLabelAnim 8s ease-in-out infinite; }

  @keyframes nodeAnim {
    /* 0–1s: all gray */
    0%, 12.5% { fill: #94A3B8; }
    /* 1–2s: election (yellow flash) */
    12.5%, 25% { fill: #FCD34D; }
    /* 2–8s: settled — leader=green, others=slate */
    25%, 100% { fill: #64748B; }
  }
  @keyframes leaderGlow {
    0%, 12.5% { fill: #94A3B8; r: 18; }
    12.5%, 25% { fill: #FCD34D; r: 20; }
    25%, 100% { fill: #16A34A; r: 20; }
  }
  @keyframes electionFlash {
    0%, 12.5% { opacity: 0; }
    15%, 22% { opacity: 1; }
    25%, 100% { opacity: 0; }
  }
  @keyframes hbDash {
    0%, 25% { stroke-dashoffset: 30; opacity: 0; }
    35% { opacity: 0.8; }
    100% { stroke-dashoffset: 0; opacity: 0.8; }
  }
  @keyframes hbDot1 {
    0%, 30% { opacity: 0; transform: translate(0,0); }
    40% { opacity: 1; }
    65% { opacity: 1; transform: translate(var(--dx1),var(--dy1)); }
    75%, 100% { opacity: 0; transform: translate(var(--dx1),var(--dy1)); }
  }
  @keyframes hbDot2 {
    0%, 35% { opacity: 0; transform: translate(0,0); }
    45% { opacity: 1; }
    70% { opacity: 1; transform: translate(var(--dx2),var(--dy2)); }
    80%, 100% { opacity: 0; transform: translate(var(--dx2),var(--dy2)); }
  }
  @keyframes hbDot3 {
    0%, 40% { opacity: 0; transform: translate(0,0); }
    50% { opacity: 1; }
    75% { opacity: 1; transform: translate(var(--dx3),var(--dy3)); }
    85%, 100% { opacity: 0; transform: translate(var(--dx3),var(--dy3)); }
  }
  @keyframes hbDot4 {
    0%, 45% { opacity: 0; transform: translate(0,0); }
    55% { opacity: 1; }
    80% { opacity: 1; transform: translate(var(--dx4),var(--dy4)); }
    90%, 100% { opacity: 0; transform: translate(var(--dx4),var(--dy4)); }
  }
  @media (prefers-reduced-motion: reduce) { * { animation-play-state: paused !important; } }
</style>

<rect x="2" y="2" width="596" height="276" rx="10" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
<text x="300" y="26" text-anchor="middle" font-family="system-ui" font-size="15" font-weight="800" fill="#1E293B">Leader Election</text>

<!--
  Pentagon layout: cx=300, cy=148, radius=105
  Node positions (angle 0 = top, clockwise):
  Node 1 (Leader): top        = (300, 43)          angle= -90°
  Node 2:          upper-right = (300+105*cos(-18°), 148+105*sin(-18°)) ≈ (400, 116)   angle= -18°  → (300+99.8, 148-32.5) ≈ (400, 116)
  Node 3:          lower-right = (300+105*cos(54°),  148+105*sin(54°))  ≈ (362, 233)   angle= 54°  → (300+61.7, 148+85)  ≈ (362, 233)
  Node 4:          lower-left  = (300+105*cos(126°), 148+105*sin(126°)) ≈ (238, 233)   angle= 126° → (300-61.7, 148+85)  ≈ (238, 233)
  Node 5:          upper-left  = (300+105*cos(198°), 148+105*sin(198°)) ≈ (200, 116)   angle= 198° → (300-99.8, 148-32.5) ≈ (200, 116)

  Exact values:
  cos(-90°)=0,    sin(-90°)=-1  →  (300, 43)
  cos(-18°)=0.951, sin(-18°)=-0.309  →  (300+99.9, 148-32.4) = (400, 116)
  cos(54°)=0.588, sin(54°)=0.809  →  (300+61.7, 148+84.9) = (362, 233)
  cos(126°)=-0.588, sin(126°)=0.809  →  (300-61.7, 148+84.9) = (238, 233)
  cos(198°)=-0.951, sin(198°)=-0.309  →  (300-99.9, 148-32.4) = (200, 116)
-->

<!-- Heartbeat lines: Leader (300,43) to each follower - show after election -->
<line x1="300" y1="43" x2="400" y2="116" stroke="#16A34A" stroke-width="1.5" class="hb-line"/>
<line x1="300" y1="43" x2="362" y2="233" stroke="#16A34A" stroke-width="1.5" class="hb-line" style="animation-delay:0.2s"/>
<line x1="300" y1="43" x2="238" y2="233" stroke="#16A34A" stroke-width="1.5" class="hb-line" style="animation-delay:0.4s"/>
<line x1="300" y1="43" x2="200" y2="116" stroke="#16A34A" stroke-width="1.5" class="hb-line" style="animation-delay:0.6s"/>

<!-- Heartbeat dots traveling from leader to followers -->
<circle cx="300" cy="43" r="5" fill="#16A34A" style="--dx1:100px;--dy1:73px" class="hb-dot1"/>
<circle cx="300" cy="43" r="5" fill="#16A34A" style="--dx2:62px;--dy2:190px" class="hb-dot2"/>
<circle cx="300" cy="43" r="5" fill="#16A34A" style="--dx3:-62px;--dy3:190px" class="hb-dot3"/>
<circle cx="300" cy="43" r="5" fill="#16A34A" style="--dx4:-100px;--dy4:73px" class="hb-dot4"/>

<!-- NODE 1 - LEADER (top) -->
<circle cx="300" cy="43" r="18" fill="#94A3B8" stroke="white" stroke-width="2.5" class="leader-glow"/>
<text x="300" y="40" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">Node</text>
<text x="300" y="51" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">1</text>
<!-- Crown/star above Node1 (appears after election) -->
<text x="300" y="16" text-anchor="middle" font-family="system-ui" font-size="16" fill="#FCD34D" class="leader-glow" style="animation: leaderCrown 8s ease-in-out infinite;">&#9733;</text>
<text x="300" y="10" text-anchor="middle" font-family="system-ui" font-size="8" font-weight="700" fill="#16A34A" class="leader-glow" style="animation: leaderCrown 8s ease-in-out infinite;">Leader</text>

<!-- NODE 2 (upper-right) -->
<circle cx="400" cy="116" r="18" fill="#94A3B8" stroke="white" stroke-width="2.5" class="node-base2"/>
<text x="400" y="113" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">Node</text>
<text x="400" y="124" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">2</text>
<text x="430" y="116" font-family="system-ui" font-size="9" fill="#16A34A" font-weight="700" class="leader-glow" style="animation: followerLabel 8s ease-in-out infinite; animation-delay: 0.1s;">Follower</text>

<!-- NODE 3 (lower-right) -->
<circle cx="362" cy="233" r="18" fill="#94A3B8" stroke="white" stroke-width="2.5" class="node-base3"/>
<text x="362" y="230" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">Node</text>
<text x="362" y="241" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">3</text>
<text x="392" y="237" font-family="system-ui" font-size="9" fill="#16A34A" font-weight="700" class="leader-glow" style="animation: followerLabel 8s ease-in-out infinite; animation-delay: 0.2s;">Follower</text>

<!-- NODE 4 (lower-left) -->
<circle cx="238" cy="233" r="18" fill="#94A3B8" stroke="white" stroke-width="2.5" class="node-base4"/>
<text x="238" y="230" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">Node</text>
<text x="238" y="241" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">4</text>
<text x="194" y="237" text-anchor="end" font-family="system-ui" font-size="9" fill="#16A34A" font-weight="700" class="leader-glow" style="animation: followerLabel 8s ease-in-out infinite; animation-delay: 0.3s;">Follower</text>

<!-- NODE 5 (upper-left) -->
<circle cx="200" cy="116" r="18" fill="#94A3B8" stroke="white" stroke-width="2.5" class="node-base5"/>
<text x="200" y="113" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">Node</text>
<text x="200" y="124" text-anchor="middle" font-family="system-ui" font-size="9" fill="white" font-weight="800">5</text>
<text x="170" y="116" text-anchor="end" font-family="system-ui" font-size="9" fill="#16A34A" font-weight="700" class="leader-glow" style="animation: followerLabel 8s ease-in-out infinite; animation-delay: 0.4s;">Follower</text>

<!-- Election flash overlay label -->
<rect x="200" y="122" width="200" height="28" rx="6" fill="#FEF3C7" stroke="#FCD34D" stroke-width="1.5" class="election-flash"/>
<text x="300" y="141" text-anchor="middle" font-family="system-ui" font-size="11" font-weight="700" fill="#92400E" class="election-flash">Election in progress...</text>

<!-- Bottom phases legend -->
<rect x="12" y="247" width="574" height="28" rx="6" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="50" y="260" text-anchor="middle" font-family="system-ui" font-size="8" fill="#4338CA">Phase 1:</text>
<text x="50" y="270" text-anchor="middle" font-family="system-ui" font-size="8" fill="#64748B">All gray</text>
<line x1="90" y1="248" x2="90" y2="275" stroke="#C7D2FE" stroke-width="1"/>
<text x="150" y="260" text-anchor="middle" font-family="system-ui" font-size="8" fill="#4338CA">Phase 2:</text>
<text x="150" y="270" text-anchor="middle" font-family="system-ui" font-size="8" fill="#64748B">Election (yellow)</text>
<line x1="210" y1="248" x2="210" y2="275" stroke="#C7D2FE" stroke-width="1"/>
<text x="300" y="260" text-anchor="middle" font-family="system-ui" font-size="8" fill="#4338CA">Phase 3:</text>
<text x="300" y="270" text-anchor="middle" font-family="system-ui" font-size="8" fill="#64748B">Leader green ★  ·  Followers send heartbeats ack</text>
<line x1="460" y1="248" x2="460" y2="275" stroke="#C7D2FE" stroke-width="1"/>
<text x="530" y="260" text-anchor="middle" font-family="system-ui" font-size="8" fill="#4338CA">Loops</text>
<text x="530" y="270" text-anchor="middle" font-family="system-ui" font-size="8" fill="#64748B">continuously</text>

<style>
  @keyframes leaderCrown {
    0%, 12.5% { opacity: 0; fill: #FCD34D; }
    12.5%, 25% { opacity: 1; fill: #FCD34D; }
    25%, 100% { opacity: 1; fill: #16A34A; }
  }
  @keyframes followerLabel {
    0%, 25% { opacity: 0; }
    35%, 100% { opacity: 1; }
  }
</style>
</svg>
</div>
