---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <style>
    .to-label { font-family: sans-serif; font-size: 10px; fill: #1E293B; text-anchor: middle; }
    .to-label-sm { font-family: sans-serif; font-size: 8.5px; fill: #64748B; text-anchor: middle; }
    .to-title { font-family: sans-serif; font-size: 10px; fill: #4F46E5; font-weight: 700; text-anchor: middle; }

    /* Seesaw 1: tips left (consistency heavier) */
    @keyframes to-beam1 {
      0%,100% { transform: rotate(-12deg); }
      50%     { transform: rotate(12deg); }
    }
    /* Seesaw 2: tips right (consistency heavier on right) */
    @keyframes to-beam2 {
      0%,100% { transform: rotate(10deg); }
      50%     { transform: rotate(-10deg); }
    }
    /* Seesaw 3: equal oscillation */
    @keyframes to-beam3 {
      0%,100% { transform: rotate(-9deg); }
      50%     { transform: rotate(9deg); }
    }

    .to-beam1 { animation: to-beam1 3.2s ease-in-out infinite; transform-origin: 300px 72px; }
    .to-beam2 { animation: to-beam2 3.8s ease-in-out infinite; transform-origin: 300px 152px; }
    .to-beam3 { animation: to-beam3 4.2s ease-in-out infinite; transform-origin: 300px 232px; }

    @media (prefers-reduced-motion: reduce) { * { animation-play-state: paused !important; } }
  </style>

  <rect width="600" height="280" fill="#F1F5F9" rx="8"/>
  <text x="300" y="18" class="to-label" font-size="12" font-weight="700" fill="#1E293B">System Design Trade-Offs</text>

  <!-- ═══ SEESAW 1: CAP Theorem ═══ -->
  <!-- Pivot triangle -->
  <polygon points="300,88 290,104 310,104" fill="#94A3B8" stroke="#64748B" stroke-width="1"/>
  <rect x="285" y="103" width="30" height="5" rx="2" fill="#94A3B8"/>

  <!-- Beam (rotates around pivot) -->
  <g class="to-beam1">
    <rect x="138" y="68" width="324" height="8" rx="4" fill="#4F46E5"/>
    <!-- Left pan -->
    <rect x="120" y="76" width="60" height="28" rx="4" fill="#EEF2FF" stroke="#4F46E5" stroke-width="1.5"/>
    <text x="150" y="91" class="to-label" fill="#3730A3" font-weight="700">Consistency</text>
    <!-- Right pan -->
    <rect x="420" y="76" width="62" height="28" rx="4" fill="#EEF2FF" stroke="#4F46E5" stroke-width="1.5"/>
    <text x="451" y="91" class="to-label" fill="#3730A3" font-weight="700">Availability</text>
    <!-- Weight indicator lines -->
    <line x1="150" y1="76" x2="150" y2="68" stroke="#4F46E5" stroke-width="1.5"/>
    <line x1="451" y1="76" x2="451" y2="68" stroke="#4F46E5" stroke-width="1.5"/>
  </g>
  <text x="300" y="116" class="to-title">CAP Theorem</text>
  <text x="300" y="128" class="to-label-sm">Choose 2 of 3: Consistency, Availability, Partition Tolerance</text>

  <!-- ═══ SEESAW 2: Latency vs Consistency ═══ -->
  <polygon points="300,168 290,184 310,184" fill="#94A3B8" stroke="#64748B" stroke-width="1"/>
  <rect x="285" y="183" width="30" height="5" rx="2" fill="#94A3B8"/>

  <g class="to-beam2">
    <rect x="138" y="148" width="324" height="8" rx="4" fill="#16A34A"/>
    <rect x="120" y="156" width="68" height="28" rx="4" fill="#DCFCE7" stroke="#16A34A" stroke-width="1.5"/>
    <text x="154" y="168" class="to-label" fill="#15803D" font-weight="700">Low Latency</text>
    <text x="154" y="179" class="to-label-sm" fill="#15803D">(eventual)</text>
    <rect x="412" y="156" width="70" height="28" rx="4" fill="#DCFCE7" stroke="#16A34A" stroke-width="1.5"/>
    <text x="447" y="168" class="to-label" fill="#15803D" font-weight="700">Consistency</text>
    <text x="447" y="179" class="to-label-sm" fill="#15803D">(strong)</text>
    <line x1="154" y1="156" x2="154" y2="148" stroke="#16A34A" stroke-width="1.5"/>
    <line x1="447" y1="156" x2="447" y2="148" stroke="#16A34A" stroke-width="1.5"/>
  </g>
  <text x="300" y="196" class="to-title" fill="#16A34A">Latency vs Consistency</text>
  <text x="300" y="208" class="to-label-sm">Faster reads need eventual consistency; strong consistency adds latency</text>

  <!-- ═══ SEESAW 3: Cost vs Performance ═══ -->
  <polygon points="300,248 290,264 310,264" fill="#94A3B8" stroke="#64748B" stroke-width="1"/>
  <rect x="285" y="263" width="30" height="5" rx="2" fill="#94A3B8"/>

  <g class="to-beam3">
    <rect x="138" y="228" width="324" height="8" rx="4" fill="#D97706"/>
    <rect x="118" y="236" width="66" height="28" rx="4" fill="#FEF3C7" stroke="#D97706" stroke-width="1.5"/>
    <text x="151" y="249" class="to-label" fill="#92400E" font-weight="700">Low Cost</text>
    <text x="151" y="260" class="to-label-sm" fill="#92400E">(HDD, smaller)</text>
    <rect x="416" y="236" width="70" height="28" rx="4" fill="#FEF3C7" stroke="#D97706" stroke-width="1.5"/>
    <text x="451" y="249" class="to-label" fill="#92400E" font-weight="700">Performance</text>
    <text x="451" y="260" class="to-label-sm" fill="#92400E">(SSD, more RAM)</text>
    <line x1="151" y1="236" x2="151" y2="228" stroke="#D97706" stroke-width="1.5"/>
    <line x1="451" y1="236" x2="451" y2="228" stroke="#D97706" stroke-width="1.5"/>
  </g>
  <text x="300" y="271" class="to-title" fill="#D97706" font-size="9">Cost vs Performance</text>
</svg>
</div>
