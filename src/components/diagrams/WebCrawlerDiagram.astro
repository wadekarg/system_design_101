---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="wc-arr" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#94A3B8"/>
    </marker>
    <marker id="wc-arr-acc" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#4F46E5"/>
    </marker>
    <marker id="wc-arr-grn" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#16A34A"/>
    </marker>
    <marker id="wc-arr-amb" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
      <path d="M0,0 L0,6 L6,3 z" fill="#D97706"/>
    </marker>
  </defs>
  <style>
    /* 7s crawl loop: Frontier→Fetcher→Parser→Indexer, then new links back */
    @keyframes wc-main {
      0%   { opacity:0; }
      3%   { opacity:1; }
      90%  { opacity:1; }
      95%  { opacity:0; }
      100% { opacity:0; }
    }

    @keyframes wc-frontier-pulse {
      0%,100% { opacity:1; transform:scale(1); }
      8%      { opacity:1; transform:scale(1.04); }
      16%     { opacity:1; transform:scale(1); }
    }
    @keyframes wc-fetcher-glow {
      0%,25%  { stroke:#E2E8F0; stroke-width:1.5; }
      30%     { stroke:#4F46E5; stroke-width:3; }
      45%     { stroke:#E2E8F0; stroke-width:1.5; }
      100%    { stroke:#E2E8F0; stroke-width:1.5; }
    }
    @keyframes wc-parser-glow {
      0%,50%  { stroke:#E2E8F0; stroke-width:1.5; }
      55%     { stroke:#4F46E5; stroke-width:3; }
      70%     { stroke:#E2E8F0; stroke-width:1.5; }
      100%    { stroke:#E2E8F0; stroke-width:1.5; }
    }
    @keyframes wc-indexer-glow {
      0%,70%  { stroke:#E2E8F0; stroke-width:1.5; }
      75%     { stroke:#16A34A; stroke-width:3; }
      90%     { stroke:#E2E8F0; stroke-width:1.5; }
      100%    { stroke:#E2E8F0; stroke-width:1.5; }
    }

    .wc-dot     { animation: wc-main 7s linear infinite; }
    .wc-frontier{ animation: wc-frontier-pulse 7s ease-in-out infinite; transform-origin:75px 110px; }
    .wc-fetcher { animation: wc-fetcher-glow 7s linear infinite; }
    .wc-parser  { animation: wc-parser-glow 7s linear infinite; }
    .wc-indexer { animation: wc-indexer-glow 7s linear infinite; }

    @media (prefers-reduced-motion: reduce) {
      * { animation-play-state: paused !important; }
    }
  </style>

  <rect width="600" height="280" fill="#F8FAFC" rx="12"/>
  <text x="300" y="22" text-anchor="middle" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#1E293B">Web Crawler — Architecture</text>

  <!-- ── URL Frontier (queue) ── -->
  <g class="wc-frontier">
    <rect x="10" y="70" width="110" height="80" rx="7" fill="#EEF2FF" stroke="#4F46E5" stroke-width="2"/>
    <!-- Queue visual -->
    <rect x="22" y="84" width="86" height="14" rx="3" fill="#C7D2FE"/>
    <rect x="22" y="102" width="86" height="14" rx="3" fill="#A5B4FC"/>
    <rect x="22" y="120" width="86" height="14" rx="3" fill="#818CF8"/>
    <text x="65" y="96"  text-anchor="middle" font-family="monospace,sans-serif" font-size="7" fill="#3730A3">https://a.com</text>
    <text x="65" y="114" text-anchor="middle" font-family="monospace,sans-serif" font-size="7" fill="#3730A3">https://b.com</text>
    <text x="65" y="132" text-anchor="middle" font-family="monospace,sans-serif" font-size="7" fill="white">https://c.com</text>
    <text x="65" y="160" text-anchor="middle" font-family="system-ui,sans-serif" font-size="10" font-weight="700" fill="#4F46E5">URL Frontier</text>
  </g>

  <!-- Arrow: Frontier→Fetcher -->
  <line x1="120" y1="110" x2="154" y2="110" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#wc-arr)"/>

  <!-- ── robots.txt check ── -->
  <rect x="128" y="68" width="82" height="56" rx="5" fill="#FFFBEB" stroke="#D97706" stroke-width="1.5"/>
  <text x="169" y="87"  text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" font-weight="700" fill="#D97706">robots.txt</text>
  <text x="169" y="100" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#92400E">check</text>
  <text x="169" y="115" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#D97706">Polite delay:</text>
  <text x="169" y="127" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7.5" fill="#D97706">1s per domain</text>

  <!-- Arrow: robots.txt→Fetcher -->
  <line x1="210" y1="110" x2="238" y2="110" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#wc-arr)"/>

  <!-- ── Fetcher ── -->
  <rect x="240" y="76" width="94" height="68" rx="7" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5" class="wc-fetcher"/>
  <text x="287" y="104" text-anchor="middle" font-family="system-ui,sans-serif" font-size="11" font-weight="700" fill="#1E293B">Fetcher</text>
  <text x="287" y="120" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#64748B">HTTP GET</text>
  <text x="287" y="134" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8" fill="#94A3B8">DNS resolve</text>

  <!-- Arrow: Fetcher→Parser -->
  <line x1="334" y1="110" x2="364" y2="110" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#wc-arr)"/>

  <!-- ── Parser ── -->
  <rect x="366" y="76" width="94" height="68" rx="7" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5" class="wc-parser"/>
  <text x="413" y="104" text-anchor="middle" font-family="system-ui,sans-serif" font-size="11" font-weight="700" fill="#1E293B">Parser</text>
  <text x="413" y="120" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#64748B">HTML parse</text>
  <text x="413" y="134" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8" fill="#94A3B8">extract links</text>

  <!-- Arrow: Parser→Indexer -->
  <line x1="460" y1="110" x2="488" y2="110" stroke="#CBD5E1" stroke-width="1.5" marker-end="url(#wc-arr)"/>

  <!-- ── Indexer ── -->
  <rect x="490" y="76" width="100" height="68" rx="7" fill="#F0FDF4" stroke="#16A34A" stroke-width="1.5" class="wc-indexer"/>
  <text x="540" y="104" text-anchor="middle" font-family="system-ui,sans-serif" font-size="11" font-weight="700" fill="#16A34A">Indexer</text>
  <text x="540" y="120" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8.5" fill="#64748B">store content</text>
  <text x="540" y="134" text-anchor="middle" font-family="system-ui,sans-serif" font-size="8" fill="#94A3B8">ElasticSearch</text>

  <!-- Arrow: Indexer→back to Frontier (arc below) -->
  <path d="M540 144 Q540 220 65 180 Q65 165 65 160" fill="none" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#wc-arr-acc)"/>
  <text x="320" y="218" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" font-weight="600" fill="#4F46E5">new links found → back to queue</text>

  <!-- Animated main crawl dot -->
  <circle r="5.5" fill="#4F46E5" class="wc-dot">
    <animate attributeName="cx" values="65;65;169;169;287;413;540;540;380;65" keyTimes="0;0.06;0.18;0.28;0.42;0.58;0.72;0.80;0.88;0.95" dur="7s" repeatCount="indefinite"/>
    <animate attributeName="cy" values="110;110;110;110;110;110;110;180;220;165" keyTimes="0;0.06;0.18;0.28;0.42;0.58;0.72;0.80;0.88;0.95" dur="7s" repeatCount="indefinite"/>
  </circle>

  <!-- Separator line for legend -->
  <line x1="10" y1="244" x2="590" y2="244" stroke="#E2E8F0" stroke-width="1"/>
  <rect x="10" y="248" width="580" height="26" rx="5" fill="#F1F5F9" stroke="#E2E8F0" stroke-width="1"/>
  <text x="300" y="265" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" fill="#475569">Respect robots.txt · 1 req/s per domain · Deduplicate URLs with Bloom filter · Prioritize by PageRank</text>
</svg>
</div>
