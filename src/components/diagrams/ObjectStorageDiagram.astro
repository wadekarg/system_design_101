---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
<style>
  .obj-label { font-family: system-ui, sans-serif; font-size: 10px; fill: #64748B; }
  .obj-code { font-family: monospace; font-size: 9px; fill: #1E293B; }
  .upload-dot { animation: uploadDot 2.5s ease-in-out infinite; }
  .download-dot { animation: downloadDot 2.5s ease-in-out infinite; animation-delay: 1.25s; }
  @keyframes uploadDot {
    0% { cx: 115; cy: 120; opacity: 0; }
    10% { opacity: 1; }
    80% { cx: 230; cy: 120; opacity: 1; }
    90%, 100% { cx: 230; cy: 120; opacity: 0; }
  }
  @keyframes downloadDot {
    0% { cx: 240; cy: 135; opacity: 0; }
    10% { opacity: 1; }
    80% { cx: 115; cy: 135; opacity: 1; }
    90%, 100% { cx: 115; cy: 135; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { * { animation-play-state: paused !important; } }
</style>

<rect x="2" y="2" width="596" height="276" rx="10" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
<text x="300" y="26" text-anchor="middle" font-family="system-ui" font-size="15" font-weight="800" fill="#1E293B">Object Storage</text>

<!-- APP box (left) -->
<rect x="14" y="96" width="100" height="70" rx="8" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="2"/>
<text x="64" y="124" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="700" fill="#1E293B">App</text>
<text x="64" y="141" text-anchor="middle" class="obj-label">S3 SDK</text>
<text x="64" y="157" text-anchor="middle" class="obj-label">REST API</text>

<!-- Upload arrow -->
<line x1="116" y1="120" x2="234" y2="120" stroke="#4F46E5" stroke-width="2"/>
<polygon points="232,115 244,120 232,125" fill="#4F46E5"/>
<text x="175" y="112" text-anchor="middle" class="obj-label" fill="#4F46E5" font-weight="600">PUT upload</text>
<!-- Download arrow (return) -->
<line x1="234" y1="135" x2="116" y2="135" stroke="#16A34A" stroke-width="1.5" stroke-dasharray="4,3"/>
<polygon points="118,130 106,135 118,140" fill="#16A34A"/>
<text x="175" y="150" text-anchor="middle" class="obj-label" fill="#16A34A">GET download</text>

<!-- Animated dots -->
<circle r="5" fill="#4F46E5" class="upload-dot"/>
<circle r="5" fill="#16A34A" class="download-dot"/>

<!-- BUCKET (center) - drawn as cylinder -->
<ellipse cx="300" cy="88" rx="55" ry="14" fill="#4F46E5" stroke="#3730A3" stroke-width="2"/>
<rect x="245" y="88" width="110" height="80" fill="#4F46E5" stroke="none"/>
<rect x="245" y="88" width="110" height="80" fill="url(#bucketGrad)" stroke="none"/>
<ellipse cx="300" cy="168" rx="55" ry="14" fill="#3730A3" stroke="#3730A3" stroke-width="2"/>
<line x1="245" y1="88" x2="245" y2="168" stroke="#3730A3" stroke-width="2"/>
<line x1="355" y1="88" x2="355" y2="168" stroke="#3730A3" stroke-width="2"/>
<ellipse cx="300" cy="88" rx="55" ry="14" fill="#6366F1" stroke="#3730A3" stroke-width="2"/>
<defs>
  <linearGradient id="bucketGrad" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0%" stop-color="#3730A3"/>
    <stop offset="100%" stop-color="#4F46E5"/>
  </linearGradient>
</defs>
<!-- Bucket label -->
<text x="300" y="125" text-anchor="middle" font-family="system-ui" font-size="11" font-weight="800" fill="white">my-bucket</text>
<text x="300" y="142" text-anchor="middle" font-family="system-ui" font-size="9" fill="#C7D2FE">Object Storage</text>
<text x="300" y="157" text-anchor="middle" font-family="system-ui" font-size="9" fill="#A5B4FC">S3 / GCS / Azure Blob</text>

<!-- Flat namespace label -->
<rect x="225" y="185" width="150" height="36" rx="5" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="300" y="199" text-anchor="middle" font-family="monospace" font-size="8" fill="#4F46E5" font-weight="700">Flat namespace (no dirs)</text>
<text x="300" y="213" text-anchor="middle" font-family="monospace" font-size="8" fill="#3730A3">photos/user123/avatar.jpg</text>

<!-- NO filesystem tree (crossed out) -->
<rect x="14" y="195" width="125" height="72" rx="6" fill="#FFF1F2" stroke="#FECDD3" stroke-width="1.5"/>
<text x="76" y="210" text-anchor="middle" font-family="system-ui" font-size="9" font-weight="700" fill="#9F1239">No filesystem hierarchy</text>
<text x="26" y="225" font-family="monospace" font-size="8" fill="#94A3B8">/home/user/</text>
<text x="36" y="238" font-family="monospace" font-size="8" fill="#94A3B8">photos/</text>
<text x="46" y="251" font-family="monospace" font-size="8" fill="#94A3B8">avatar.jpg</text>
<!-- Red X strikethrough lines -->
<line x1="18" y1="198" x2="135" y2="263" stroke="#EF4444" stroke-width="3" opacity="0.7"/>
<line x1="135" y1="198" x2="18" y2="263" stroke="#EF4444" stroke-width="3" opacity="0.7"/>

<!-- RIGHT SIDE: Object anatomy -->
<rect x="395" y="60" width="190" height="175" rx="8" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
<text x="490" y="80" text-anchor="middle" font-family="system-ui" font-size="11" font-weight="700" fill="#1E293B">Object Anatomy</text>
<!-- Bucket Name -->
<rect x="408" y="88" width="165" height="30" rx="4" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="416" y="101" font-family="system-ui" font-size="8" font-weight="700" fill="#4F46E5">Bucket Name</text>
<text x="416" y="113" font-family="monospace" font-size="8" fill="#1E293B">my-photos-bucket</text>
<!-- Object Key -->
<rect x="408" y="124" width="165" height="30" rx="4" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="416" y="137" font-family="system-ui" font-size="8" font-weight="700" fill="#4F46E5">Object Key (path)</text>
<text x="416" y="149" font-family="monospace" font-size="8" fill="#1E293B">user/123/avatar.jpg</text>
<!-- Blob Data -->
<rect x="408" y="160" width="165" height="30" rx="4" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="416" y="173" font-family="system-ui" font-size="8" font-weight="700" fill="#4F46E5">Blob Data + Metadata</text>
<text x="416" y="185" font-family="monospace" font-size="8" fill="#1E293B">bytes + Content-Type, ETag</text>
<!-- Immutable badge -->
<rect x="408" y="196" width="165" height="30" rx="4" fill="#F0FDF4" stroke="#BBF7D0" stroke-width="1"/>
<text x="416" y="209" font-family="system-ui" font-size="8" font-weight="700" fill="#16A34A">Immutable (write-once)</text>
<text x="416" y="221" font-family="monospace" font-size="8" fill="#15803D">Versioned · Replicated · Durable</text>

<!-- Bottom note -->
<rect x="12" y="244" width="200" height="28" rx="5" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
<text x="112" y="256" text-anchor="middle" font-family="system-ui" font-size="9" font-weight="700" fill="#4F46E5">Use for large unstructured data</text>
<text x="112" y="267" text-anchor="middle" font-family="system-ui" font-size="9" fill="#4338CA">Images · Videos · Backups · Logs</text>
</svg>
</div>
