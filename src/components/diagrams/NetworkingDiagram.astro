---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <style>
    @keyframes step1 {
      0%, 10%  { opacity: 0; }
      15%, 40% { opacity: 1; }
      45%, 100% { opacity: 0; }
    }
    @keyframes step2 {
      0%, 35%  { opacity: 0; }
      42%, 60% { opacity: 1; }
      65%, 100% { opacity: 0; }
    }
    @keyframes step3 {
      0%, 55%  { opacity: 0; }
      62%, 77% { opacity: 1; }
      82%, 100% { opacity: 0; }
    }
    @keyframes step4 {
      0%, 72%  { opacity: 0; }
      80%, 93% { opacity: 1; }
      98%, 100% { opacity: 0; }
    }
    .s1 { animation: step1 5s ease-in-out infinite; }
    .s2 { animation: step2 5s ease-in-out infinite; }
    .s3 { animation: step3 5s ease-in-out infinite; }
    .s4 { animation: step4 5s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) {
      * { animation-play-state: paused !important; }
    }
  </style>
  <defs>
    <marker id="ah" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 8 3, 0 6" fill="#4F46E5"/>
    </marker>
    <marker id="ah-green" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 8 3, 0 6" fill="#16A34A"/>
    </marker>
  </defs>

  <!-- Client box -->
  <rect x="20" y="105" width="110" height="50" rx="8" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="75" y="127" font-family="system-ui,sans-serif" font-size="13" font-weight="700" fill="#1E293B" text-anchor="middle">Client</text>
  <text x="75" y="144" font-family="system-ui,sans-serif" font-size="10" fill="#64748B" text-anchor="middle">Browser</text>

  <!-- DNS Server box -->
  <rect x="390" y="20" width="130" height="50" rx="8" fill="#FEF3C7" stroke="#FCD34D" stroke-width="1.5"/>
  <text x="455" y="42" font-family="system-ui,sans-serif" font-size="13" font-weight="700" fill="#92400E" text-anchor="middle">DNS Server</text>
  <text x="455" y="59" font-family="system-ui,sans-serif" font-size="10" fill="#B45309" text-anchor="middle">Resolves names</text>

  <!-- Web Server box -->
  <rect x="390" y="185" width="130" height="50" rx="8" fill="#F0FDF4" stroke="#86EFAC" stroke-width="1.5"/>
  <text x="455" y="207" font-family="system-ui,sans-serif" font-size="13" font-weight="700" fill="#15803D" text-anchor="middle">Web Server</text>
  <text x="455" y="224" font-family="system-ui,sans-serif" font-size="10" fill="#16A34A" text-anchor="middle">Serves content</text>

  <!-- Step 1: Client → DNS (query) -->
  <g class="s1">
    <line x1="132" y1="118" x2="388" y2="52" stroke="#4F46E5" stroke-width="2" marker-end="url(#ah)"/>
    <rect x="220" y="60" width="100" height="20" rx="4" fill="white" opacity="0.9"/>
    <text x="270" y="74" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#4F46E5" text-anchor="middle">① DNS query</text>
  </g>

  <!-- Step 2: DNS → Client (IP response) -->
  <g class="s2">
    <line x1="388" y1="60" x2="134" y2="124" stroke="#D97706" stroke-width="2" marker-end="url(#ah)"/>
    <rect x="215" y="78" width="110" height="20" rx="4" fill="white" opacity="0.9"/>
    <text x="270" y="92" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#D97706" text-anchor="middle">② IP: 93.184.x.x</text>
  </g>

  <!-- Step 3: Client → Web Server (HTTP GET) -->
  <g class="s3">
    <line x1="132" y1="138" x2="388" y2="202" stroke="#4F46E5" stroke-width="2" marker-end="url(#ah)"/>
    <rect x="210" y="158" width="110" height="20" rx="4" fill="white" opacity="0.9"/>
    <text x="265" y="172" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#4F46E5" text-anchor="middle">③ HTTP GET /</text>
  </g>

  <!-- Step 4: Web Server → Client (200 OK) -->
  <g class="s4">
    <line x1="388" y1="212" x2="134" y2="148" stroke="#16A34A" stroke-width="2" marker-end="url(#ah-green)"/>
    <rect x="210" y="175" width="110" height="20" rx="4" fill="white" opacity="0.9"/>
    <text x="265" y="189" font-family="system-ui,sans-serif" font-size="10" font-weight="600" fill="#16A34A" text-anchor="middle">④ 200 OK + HTML</text>
  </g>

  <!-- Legend -->
  <text x="20" y="270" font-family="system-ui,sans-serif" font-size="10" fill="#94A3B8">Animates: DNS lookup → IP response → HTTP request → response</text>
</svg>
</div>
