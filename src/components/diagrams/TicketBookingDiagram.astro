---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <style>
    .tb-label { font-family: sans-serif; font-size: 10px; fill: #1E293B; text-anchor: middle; }
    .tb-label-w { font-family: sans-serif; font-size: 10px; fill: #fff; text-anchor: middle; font-weight: 600; }
    .tb-label-sm { font-family: sans-serif; font-size: 8px; fill: #64748B; text-anchor: middle; }

    @keyframes tb-arrow-a {
      0%,5%    { stroke-dashoffset: 80; opacity: 0; }
      18%      { opacity: 1; stroke-dashoffset: 0; }
      40%,100% { opacity: 0; }
    }
    @keyframes tb-arrow-b {
      0%,10%   { stroke-dashoffset: 80; opacity: 0; }
      22%      { opacity: 1; stroke-dashoffset: 0; }
      44%,100% { opacity: 0; }
    }
    @keyframes tb-lock-success {
      0%,28%   { fill: #FEF3C7; stroke: #D97706; }
      38%,68%  { fill: #DCFCE7; stroke: #16A34A; }
      80%,100% { fill: #FEF3C7; stroke: #D97706; }
    }
    @keyframes tb-path-a {
      0%,32%   { opacity: 0; }
      42%,72%  { opacity: 1; }
      82%,100% { opacity: 0; }
    }
    @keyframes tb-fail-b {
      0%,38%   { opacity: 0; }
      48%,70%  { opacity: 1; }
      80%,100% { opacity: 0; }
    }
    @keyframes tb-pay {
      0%,52%   { stroke-dashoffset: 70; opacity: 0; }
      62%      { opacity: 1; }
      80%      { stroke-dashoffset: 0; opacity: 1; }
      92%,100% { opacity: 0; }
    }

    .tb-arrow-a { animation: tb-arrow-a 5s ease-in-out infinite; }
    .tb-arrow-b { animation: tb-arrow-b 5s ease-in-out infinite; }
    .tb-lock    { animation: tb-lock-success 5s ease-in-out infinite; }
    .tb-path-a  { animation: tb-path-a 5s ease-in-out infinite; }
    .tb-fail-b  { animation: tb-fail-b 5s ease-in-out infinite; }
    .tb-pay     { animation: tb-pay    5s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) { * { animation-play-state: paused !important; } }
  </style>

  <defs>
    <marker id="tb-arr"   markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><polygon points="0 0,6 3,0 6" fill="#94A3B8"/></marker>
    <marker id="tb-arr-g" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><polygon points="0 0,6 3,0 6" fill="#16A34A"/></marker>
    <marker id="tb-arr-r" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><polygon points="0 0,6 3,0 6" fill="#DC2626"/></marker>
  </defs>

  <rect width="600" height="280" fill="#F1F5F9" rx="8"/>
  <text x="300" y="18" class="tb-label" font-size="11" font-weight="700" fill="#4F46E5">Ticket Booking — Distributed Lock (Race Condition)</text>

  <!-- User A -->
  <rect x="20" y="38" width="78" height="38" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="59" y="56" class="tb-label" font-weight="700">User A</text>
  <text x="59" y="70" class="tb-label" font-size="8" fill="#16A34A">→ book seat_42</text>

  <!-- User B -->
  <rect x="20" y="108" width="78" height="38" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <text x="59" y="126" class="tb-label" font-weight="700">User B</text>
  <text x="59" y="140" class="tb-label" font-size="8" fill="#DC2626">→ book seat_42</text>

  <!-- Animated arrows → Reservation Service -->
  <line x1="98" y1="57" x2="216" y2="102"
        stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3"
        class="tb-arrow-a" marker-end="url(#tb-arr)"/>
  <line x1="98" y1="128" x2="216" y2="120"
        stroke="#4F46E5" stroke-width="2" stroke-dasharray="6,3"
        class="tb-arrow-b" marker-end="url(#tb-arr)"/>

  <!-- Reservation Service -->
  <rect x="216" y="92" width="114" height="52" rx="6" fill="#4F46E5" stroke="#3730A3" stroke-width="1.5"/>
  <text x="273" y="112" class="tb-label-w">Reservation</text>
  <text x="273" y="126" class="tb-label-w">Service</text>
  <text x="273" y="139" class="tb-label" fill="#A5B4FC" font-size="7">SETNX seat_42</text>

  <!-- Arrow → Redis Lock -->
  <line x1="330" y1="118" x2="386" y2="118" stroke="#D97706" stroke-width="1.5" stroke-dasharray="4,2" marker-end="url(#tb-arr)"/>
  <text x="358" y="110" class="tb-label" font-size="7" fill="#D97706">SETNX</text>

  <!-- Redis Lock box -->
  <rect x="386" y="90" width="118" height="68" rx="6" fill="#FEF3C7" stroke="#D97706" stroke-width="2" class="tb-lock"/>
  <!-- Lock shackle -->
  <path d="M436 100 Q436 93 445 93 Q454 93 454 100" fill="none" stroke="#D97706" stroke-width="2.5"/>
  <rect x="433" y="100" width="24" height="18" rx="4" fill="#D97706"/>
  <circle cx="445" cy="109" r="3" fill="#FEF3C7"/>
  <text x="445" y="129" class="tb-label" font-weight="700" fill="#92400E" font-size="10">Redis Lock</text>
  <text x="445" y="141" class="tb-label" font-size="7.5" fill="#92400E">key: seat_42</text>
  <text x="445" y="153" class="tb-label" font-size="8" fill="#92400E" font-weight="700">TTL: 10 min</text>

  <!-- User A gets lock (success) -->
  <g class="tb-path-a">
    <rect x="216" y="72" width="114" height="18" rx="4" fill="#DCFCE7" stroke="#16A34A" stroke-width="1"/>
    <text x="273" y="84" class="tb-label" font-size="9" fill="#15803D" font-weight="700">✓ User A gets lock</text>
  </g>

  <!-- User B fails -->
  <g class="tb-fail-b">
    <rect x="216" y="150" width="114" height="18" rx="4" fill="#FEE2E2" stroke="#DC2626" stroke-width="1"/>
    <text x="273" y="162" class="tb-label" font-size="9" fill="#DC2626" font-weight="700">✗ Seat Taken</text>
    <!-- Return arrow to User B -->
    <line x1="216" y1="159" x2="100" y2="142" stroke="#DC2626" stroke-width="1.5" stroke-dasharray="4,2" marker-end="url(#tb-arr-r)"/>
  </g>

  <!-- Payment Service -->
  <rect x="160" y="208" width="106" height="36" rx="6" fill="#DCFCE7" stroke="#16A34A" stroke-width="1.5"/>
  <text x="213" y="226" class="tb-label" fill="#15803D" font-weight="700">Payment Service</text>
  <text x="213" y="238" class="tb-label" font-size="7" fill="#15803D">charge + confirm</text>

  <!-- DB cylinder -->
  <g transform="translate(318,204)">
    <ellipse cx="53" cy="10" rx="28" ry="7" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1"/>
    <rect x="25" y="10" width="56" height="30" fill="#F8FAFC" stroke="#94A3B8" stroke-width="1"/>
    <ellipse cx="53" cy="40" rx="28" ry="7" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1"/>
    <text x="53" y="29" class="tb-label" font-size="9">DB</text>
  </g>

  <!-- Arrow A success → Payment (animated) -->
  <line x1="273" y1="144" x2="213" y2="208"
        stroke="#16A34A" stroke-width="2" stroke-dasharray="5,3"
        class="tb-pay" marker-end="url(#tb-arr-g)"/>

  <!-- Payment → DB -->
  <line x1="266" y1="226" x2="318" y2="226" stroke="#16A34A" stroke-width="1.2" marker-end="url(#tb-arr-g)"/>

  <!-- Legend -->
  <rect x="12" y="254" width="576" height="22" rx="4" fill="#E2E8F0"/>
  <text x="18" y="269" class="tb-label" text-anchor="start" font-size="8" fill="#475569">Race condition: both users request simultaneously · Redis SETNX is atomic — only one wins · Loser receives "Seat Taken"</text>
</svg>
</div>
