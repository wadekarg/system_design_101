---
---
<div class="w-full overflow-hidden">
<svg viewBox="0 0 600 280" width="100%" xmlns="http://www.w3.org/2000/svg">
  <style>
    .cd-mono { font-family: 'Courier New', Courier, monospace; font-size: 12px; fill: #1E293B; }
    .cd-mono-b { font-family: 'Courier New', Courier, monospace; font-size: 12px; fill: #4F46E5; font-weight: bold; }
    .cd-mono-sm { font-family: 'Courier New', Courier, monospace; font-size: 10px; fill: #64748B; }
    .cd-mono-val { font-family: 'Courier New', Courier, monospace; font-size: 10px; fill: #16A34A; font-weight: bold; }
    .cd-label { font-family: sans-serif; font-size: 10px; fill: #1E293B; text-anchor: middle; }
    .cd-head { font-family: sans-serif; font-size: 11px; fill: #4F46E5; font-weight: 700; }

    /* Reveal animation: slide in from left + fade in */
    @keyframes cd-reveal1 {
      0%,5%    { opacity: 0; transform: translateX(-12px); }
      18%,100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes cd-reveal2 {
      0%,22%   { opacity: 0; transform: translateX(-12px); }
      35%,100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes cd-reveal3 {
      0%,42%   { opacity: 0; transform: translateX(-12px); }
      55%,100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes cd-reveal1v {
      0%,12%   { opacity: 0; transform: translateX(-8px); }
      28%,100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes cd-reveal2v {
      0%,32%   { opacity: 0; transform: translateX(-8px); }
      48%,100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes cd-reveal3v {
      0%,52%   { opacity: 0; transform: translateX(-8px); }
      68%,100% { opacity: 1; transform: translateX(0); }
    }

    .cd-eq1  { animation: cd-reveal1  5s ease-out infinite; }
    .cd-eq2  { animation: cd-reveal2  5s ease-out infinite; }
    .cd-eq3  { animation: cd-reveal3  5s ease-out infinite; }
    .cd-val1 { animation: cd-reveal1v 5s ease-out infinite; }
    .cd-val2 { animation: cd-reveal2v 5s ease-out infinite; }
    .cd-val3 { animation: cd-reveal3v 5s ease-out infinite; }

    @media (prefers-reduced-motion: reduce) { * { animation-play-state: paused !important; } }
  </style>

  <rect width="600" height="280" fill="#F1F5F9" rx="8"/>
  <text x="300" y="20" class="cd-label" font-size="13" font-weight="700" fill="#1E293B" text-anchor="middle">Capacity Estimation Formulas</text>

  <!-- ── Equation 1: QPS ── -->
  <rect x="16" y="30" width="568" height="64" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <!-- Badge -->
  <rect x="16" y="30" width="6" height="64" rx="3" fill="#4F46E5"/>
  <text x="32" y="48" class="cd-head">QPS</text>

  <g class="cd-eq1">
    <text x="32" y="66" class="cd-mono">QPS</text>
    <text x="70" y="66" class="cd-mono" fill="#94A3B8">=</text>
    <text x="84" y="66" class="cd-mono-b">DAU</text>
    <text x="119" y="66" class="cd-mono" fill="#94A3B8">×</text>
    <text x="133" y="66" class="cd-mono">requests_per_day</text>
    <text x="310" y="66" class="cd-mono" fill="#94A3B8">÷</text>
    <text x="324" y="66" class="cd-mono">86,400</text>
  </g>
  <g class="cd-val1">
    <text x="32" y="85" class="cd-mono-sm">Example: </text>
    <text x="100" y="85" class="cd-mono-val">300M × 1 ÷ 86,400</text>
    <text x="295" y="85" class="cd-mono-sm"> = </text>
    <text x="313" y="85" class="cd-mono-val">≈ 3.47 writes/sec</text>
  </g>

  <!-- ── Equation 2: Storage ── -->
  <rect x="16" y="104" width="568" height="72" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <rect x="16" y="104" width="6" height="72" rx="3" fill="#16A34A"/>
  <text x="32" y="122" class="cd-head" fill="#16A34A">Storage</text>

  <g class="cd-eq2">
    <text x="32" y="140" class="cd-mono">Storage</text>
    <text x="100" y="140" class="cd-mono" fill="#94A3B8">=</text>
    <text x="116" y="140" class="cd-mono-b">QPS</text>
    <text x="151" y="140" class="cd-mono" fill="#94A3B8">×</text>
    <text x="165" y="140" class="cd-mono">avg_size</text>
    <text x="243" y="140" class="cd-mono" fill="#94A3B8">×</text>
    <text x="257" y="140" class="cd-mono">seconds_per_day</text>
    <text x="440" y="140" class="cd-mono" fill="#94A3B8">×</text>
    <text x="454" y="140" class="cd-mono">days</text>
  </g>
  <g class="cd-val2">
    <text x="32" y="159" class="cd-mono-sm">Example: </text>
    <text x="100" y="159" class="cd-mono-val">3.47</text>
    <text x="131" y="159" class="cd-mono-sm"> × </text>
    <text x="148" y="159" class="cd-mono-val">140B</text>
    <text x="185" y="159" class="cd-mono-sm"> × </text>
    <text x="202" y="159" class="cd-mono-val">86,400s</text>
    <text x="263" y="159" class="cd-mono-sm"> × </text>
    <text x="280" y="159" class="cd-mono-val">30d</text>
    <text x="309" y="159" class="cd-mono-sm"> = </text>
    <text x="327" y="159" class="cd-mono-val">≈ 1.2 TB</text>
  </g>

  <!-- ── Equation 3: Bandwidth ── -->
  <rect x="16" y="186" width="568" height="64" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
  <rect x="16" y="186" width="6" height="64" rx="3" fill="#D97706"/>
  <text x="32" y="204" class="cd-head" fill="#D97706">Bandwidth</text>

  <g class="cd-eq3">
    <text x="32" y="222" class="cd-mono">Bandwidth</text>
    <text x="122" y="222" class="cd-mono" fill="#94A3B8">=</text>
    <text x="138" y="222" class="cd-mono-b">QPS</text>
    <text x="173" y="222" class="cd-mono" fill="#94A3B8">×</text>
    <text x="187" y="222" class="cd-mono">response_size</text>
  </g>
  <g class="cd-val3">
    <text x="32" y="241" class="cd-mono-sm">Example: </text>
    <text x="100" y="241" class="cd-mono-val">3.47</text>
    <text x="131" y="241" class="cd-mono-sm"> × </text>
    <text x="148" y="241" class="cd-mono-val">1 KB</text>
    <text x="183" y="241" class="cd-mono-sm"> = </text>
    <text x="201" y="241" class="cd-mono-val">3.47 KB/s</text>
    <text x="282" y="241" class="cd-mono-sm">(read bandwidth)</text>
  </g>

  <!-- Legend -->
  <rect x="16" y="258" width="568" height="18" rx="4" fill="#E2E8F0"/>
  <text x="22" y="271" class="cd-label" text-anchor="start" font-size="8" fill="#475569">DAU = Daily Active Users · Formulas reveal progressively · All based on Twitter-scale example: 300M DAU</text>
</svg>
</div>
